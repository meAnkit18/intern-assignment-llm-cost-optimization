<mxfile host="app.diagrams.net" modified="2026-11-14T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="q2" name="Question 2 - Four Stage Pipeline"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="QUESTION 2 — FOUR-STAGE COST-OPTIMIZED PIPELINE" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#205C3A;" vertex="1" parent="1"><mxGeometry x="180" y="25" width="1240" height="45" as="geometry"/></mxCell>
<mxCell id="input" value="INPUT&#xa;Ticket + order data + help-center knowledge base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4A78C2;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="100" width="540" height="80" as="geometry"/></mxCell>
<mxCell id="triage" value="1. TRIAGE — LOCAL&#xa;Read ticket and order&#xa;Extract only policy-relevant facts&#xa;(product type, delivery age, opened, damage, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF7;strokeColor=#4D9B70;fontSize=15;fontColor=#205C3A;" vertex="1" parent="1"><mxGeometry x="470" y="245" width="660" height="125" as="geometry"/></mxCell>
<mxCell id="retrieval" value="2. RETRIEVAL — LOCAL&#xa;Apply policy rules to triage facts&#xa;Select one candidate article ID&#xa;Do not send the 200k+ token KB corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF7;strokeColor=#4D9B70;fontSize=15;fontColor=#205C3A;" vertex="1" parent="1"><mxGeometry x="470" y="435" width="660" height="125" as="geometry"/></mxCell>
<mxCell id="compose" value="3. COMPOSITION — ONE LLM CALL&#xa;Send ticket thread + compact order + triage facts + selected article ID&#xa;Generate compact JSON: action, kb_article, customer_reply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F0E1;strokeColor=#4D9B70;fontSize=15;fontStyle=1;fontColor=#205C3A;" vertex="1" parent="1"><mxGeometry x="400" y="625" width="800" height="125" as="geometry"/></mxCell>
<mxCell id="audit" value="4. AUDIT — LOCAL&#xa;Parse JSON and validate allowed action + non-empty article&#xa;Reject invalid structure without another LLM call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF7;strokeColor=#4D9B70;fontSize=15;fontColor=#205C3A;" vertex="1" parent="1"><mxGeometry x="470" y="815" width="660" height="110" as="geometry"/></mxCell>
<mxCell id="out" value="FINAL STRUCTURED RESOLUTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=17;fontStyle=1;fontColor=#375623;" vertex="1" parent="1"><mxGeometry x="570" y="970" width="460" height="55" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="input" target="triage"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="triage" target="retrieval"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="retrieval" target="compose"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="compose" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;" edge="1" parent="1" source="audit" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="cost" value="COST SAVINGS&#xa;Small facts-only retrieval • one selected article • one model inference • local validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A23A;fontSize=15;fontStyle=1;fontColor=#6B4E0B;" vertex="1" parent="1"><mxGeometry x="250" y="1050" width="1100" height="70" as="geometry"/></mxCell>
